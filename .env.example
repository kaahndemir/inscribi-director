# Copy to .env for local runs. In Coolify, set these as environment variables (secrets marked as such).

# Public origin of the site; the QR code points here. Must be https except for localhost.
PUBLIC_URL=https://live.inscribi.com

# StoryVote address from deployments/10143.json.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Secret. Owner of the contract: opens, finalizes and cancels rounds and gives demo MON to participants.
OPERATOR_PRIVATE_KEY=

# Secret. Operator login link is https://live.inscribi.com/admin#<ADMIN_TOKEN>. At least 24 characters.
ADMIN_TOKEN=

# Secret. fal key used only on the server by the Director proxy.
FAL_KEY=

# live = real H3 Max Director; fake = rehearsal without video and without cost.
DIRECTOR_MODE=live

# Paid session guard. MAX_SESSIONS: Director sessions this deployment may ever start.
# MAX_SESSION_SECONDS: 0 = runs until the operator stops it (the provider caps a session at 15 min).
# FAL_BUDGET_USD: spend counted at list price ($0.08/s, 60 s minimum per session); sessions stop when it is reached.
MAX_SESSIONS=10
MAX_SESSION_SECONDS=0
FAL_BUDGET_USD=45

# Rounds: automatic flow and voting time per round.
AUTO_ROUNDS=true
ROUND_SECONDS=20
# Director video chunk length (5-15). A winner appears at the next chunk; shorter chunks show it sooner
# but freeze more often. 10 is the provider default and was steadier in live shows.
CHUNK_SECONDS=10

# Money on testnet.
VOTE_FEE_MON=0.001
DRIP_AMOUNT_MON=0.08
DRIP_LIMIT=50

# Network. A private Monad testnet RPC avoids public rate limits.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Persistent state (mount a volume here in Coolify).
DATA_DIR=/data
PORT=3000
