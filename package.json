{
  "name": "inscribi-director",
  "version": "0.1.0",
  "private": true,
  "description": "Audience votes with MON on Monad testnet to direct a live H3 Max Director video.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server/index.mjs",
    "dev": "npm run build && node --env-file=.env src/server/index.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:contracts": "forge test --root contracts --offline",
    "contract:abi": "node scripts/export-abi.mjs",
    "contract:deploy": "node scripts/deploy-contract.mjs"
  },
  "dependencies": {
    "@fal-ai/server-proxy": "1.3.0-alpha.0",
    "qrcode": "1.5.4",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@fal-ai/client": "1.11.0-alpha.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  }
}
